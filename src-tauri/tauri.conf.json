{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vora-Mind",
  "version": "0.3.5",
  "identifier": "com.alexfedura.voramind",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vora",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "fullscreen": false,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../data/ticks/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyN0IzN0VCM0Y5OUQ2MTUKUldRVjFway82emQ3a3VCTXB6RmdLWWE2Z25pR3ZEMk8yaHMyM3FSdllFRGw5WHhKVXEranBwUmUK",
      "endpoints": [
        "https://github.com/alexfedura/vora_mind/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
